# Serverio nustatymai. Nukopijuokite į „.env“ ir užpildykite (deploy/sukurti_env.sh tai padaro pats ir
# sugeneruoja slaptažodžius). .env NIEKADA nekelkite į git ir niekam nesiųskite.
# Pakeitus: docker compose up -d

# Adresas, kuriuo ekranai pasiekia serverį (DNS A įrašas → serverio IP)
DOMAIN=api.jusu-domenas.com
# El. paštas Let's Encrypt pranešimams apie HTTPS sertifikatą
ACME_EMAIL=jusu@pastas.com

# Slaptažodžiai: ilgi atsitiktiniai (openssl rand -hex 24). Jei trumpesni nei 24 simboliai, serveris nepasileis.
DB_PASSWORD=
ADMIN_TOKEN=
INTERNAL_TOKEN=

# Valdymo puslapis /admin pasiekiamas tik iš šių IP (per kablelį, galima CIDR).
# Tuščia – iš bet kur (ADMIN_TOKEN reikalingas visada).
ADMIN_ALLOW_IPS=

# Kiek api kopijų. Kiekvienai reikia ~1 procesoriaus branduolio; 2 kopijų pakanka keliems tūkstančiams ekranų.
API_REPLICAS=2

# --- Lėktuvų duomenys (app/feed.py) ---
# free     – adsb.fi / adsb.lol: nemokami, bet nekomercinė licencija ir ~1 užklausa per sekundę
# licensed – jūsų sutartis su tiekėju; rekomenduojama PROVIDER_WORLD_URL (visas pasaulis viena užklausa)
PROVIDER=free
UPSTREAMS=fi,lol
PROVIDER_URL=
PROVIDER_KEY=
PROVIDER_KEY_HEADER=api-auth
PROVIDER_HEX_PATH=icao
PROVIDER_WORLD_URL=
PROVIDER_SPACING=0.25
# Zonų režime (be PROVIDER_WORLD_URL): kiek skirtingų vietų ir sekamų skrydžių vienu metu
MAX_ZONES=600
MAX_WATCH=200

# --- Orai (Open-Meteo). Komerciniam naudojimui: https://customer-api.open-meteo.com/v1/forecast ir raktas ---
WEATHER_URL=https://api.open-meteo.com/v1/forecast
WEATHER_KEY=
